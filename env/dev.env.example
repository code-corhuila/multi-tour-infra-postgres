# Copy to env/dev.env, which is never versioned, and fill every secret. Names and placeholders only.
# A different COMPOSE_PROJECT_NAME per environment gives each one its own container and volume.
COMPOSE_PROJECT_NAME=multi-tour-dev
PG_DATABASE=multitour
PG_ADMIN_USER=multitour_admin

# Secrets: no value here, no default anywhere
PG_ADMIN_PASSWORD=
COMMERCIAL_RESERVATION_APP_PASSWORD=
OPERATIONS_COST_APP_PASSWORD=
CASH_REPORTING_APP_PASSWORD=
SECURITY_APP_PASSWORD=
WORKFLOW_ONBOARD_TENANT_APP_PASSWORD=
WORKFLOW_REGISTER_PAYMENT_APP_PASSWORD=
WORKFLOW_EXECUTE_REFUND_APP_PASSWORD=
WORKFLOW_CANCEL_DEPARTURE_APP_PASSWORD=
WORKFLOW_CHANGE_DEPARTURE_VEHICLES_APP_PASSWORD=

# The services that the root composition (platform.yml) includes. Names and placeholders only: a real value goes in env/dev.env.
MONGO_INITDB_ROOT_USERNAME=multitour_admin
MONGO_INITDB_ROOT_PASSWORD=
IDENTITY_AUDIT_APP_PASSWORD=
# The identity-audit API connects as identity_audit_app, never as the administrator; use the password above
MONGODB_URI=mongodb://identity_audit_app:CHANGE_ME@mongo:27017/identity_audit?replicaSet=rs0&authSource=identity_audit
# The public key of the security microservice on one line (line breaks written as backslash-n), and optionally the issuer and audience of its tokens
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
