# Copy to env/main.env, which is never versioned, and fill every secret. Names and placeholders only.
# A different COMPOSE_PROJECT_NAME per environment gives each one its own container and volume.
COMPOSE_PROJECT_NAME=multi-tour-main
PG_DATABASE=multitour
PG_ADMIN_USER=multitour_admin

# Secrets: no value here, no default anywhere
PG_ADMIN_PASSWORD=
COMMERCIAL_RESERVATION_APP_PASSWORD=
OPERATIONS_COST_APP_PASSWORD=
CASH_REPORTING_APP_PASSWORD=
SECURITY_APP_PASSWORD=
WORKFLOW_ONBOARD_TENANT_APP_PASSWORD=
WORKFLOW_REGISTER_PAYMENT_APP_PASSWORD=
WORKFLOW_EXECUTE_REFUND_APP_PASSWORD=
WORKFLOW_CANCEL_DEPARTURE_APP_PASSWORD=
WORKFLOW_CHANGE_DEPARTURE_VEHICLES_APP_PASSWORD=

# The services that the root composition (platform.yml) includes. Names and placeholders only: a real value goes in env/main.env.
MONGO_INITDB_ROOT_USERNAME=multitour_admin
MONGO_INITDB_ROOT_PASSWORD=
IDENTITY_AUDIT_APP_PASSWORD=
# The identity-audit API connects as identity_audit_app, never as the administrator; use the password above
MONGODB_URI=mongodb://identity_audit_app:CHANGE_ME@mongo:27017/identity_audit?replicaSet=rs0&authSource=identity_audit
# The public key of the security microservice on one line (line breaks written as backslash-n), and the issuer and audience of its tokens: names, not secrets
JWT_PUBLIC_KEY=
JWT_ISSUER=multi-tour-security
JWT_AUDIENCE=multi-tour

# The demo services (security, saga, relay, front, gateway). Names and placeholders only.
# Directory with private.pem and public.pem, absolute: scripts/dev-keys.sh makes them in ./keys (develop only)
JWT_KEYS_DIR=/absolute/path/to/multi-tour-infra-postgres/keys
# The public key as a file (mode 644), read by the saga
JWT_PUBLIC_KEY_PATH=/absolute/path/to/multi-tour-infra-postgres/keys/public.pem
# Where the services reach each other on the platform network
SECURITY_BASE_URL=http://security:8086
IDENTITY_AUDIT_BASE_URL=http://identity-audit-api:8082
OPERATIONS_COST_BASE_URL=http://multi-tour-operations-cost-api:8084
COMMERCIAL_RESERVATION_BASE_URL=http://multi-tour-commercial-reservation-api:8083
# The relay reads the outbox of cash-reporting here (HU-WRK-007, G-RL7-1)
CASH_REPORTING_BASE_URL=http://multi-tour-cash-reporting-api:8085
# Job 4, which tells the owner of an administrative account that its password was reset; the relay delivers the facts to it
NOTIFICATIONS_BASE_URL=http://worker-notifications:8080
# Service tokens, printed by scripts/dev-token.sh (develop) or given by the security service as secrets (qa, main)
SERVICE_TOKEN=CHANGE_ME
WORKFLOW_ONBOARD_TENANT_SERVICE_TOKEN=CHANGE_ME
# identity-audit-api reads the open cash boxes of a tenant from cash-reporting (HU-IDA-004): scripts/dev-token.sh identity-audit-api (develop)
IDENTITY_AUDIT_SERVICE_TOKEN=CHANGE_ME
WORKFLOW_CANCEL_DEPARTURE_SERVICE_TOKEN=CHANGE_ME
WORKFLOW_CHANGE_DEPARTURE_VEHICLES_SERVICE_TOKEN=CHANGE_ME
WORKER_DEPARTURE_DEADLINES_SERVICE_TOKEN=CHANGE_ME
# Job 5 asks the commercial api to expire the rescheduling episodes with its own token (sub worker-reprogramming-timers): scripts/dev-token.sh worker-reprogramming-timers 90d
WORKER_REPROGRAMMING_TIMERS_SERVICE_TOKEN=CHANGE_ME
# Job 4 reads the customer notices (HU-COM-015) from the commercial api with its own token (sub worker-notifications): scripts/dev-token.sh worker-notifications 90d
WORKER_NOTIFICATIONS_SERVICE_TOKEN=CHANGE_ME
# The saga of the payment and the saga of the refund (domain 02): each has its own token (sub workflow-register-payment, workflow-execute-refund): scripts/dev-token.sh <sub> 90d
WORKFLOW_REGISTER_PAYMENT_SERVICE_TOKEN=CHANGE_ME
WORKFLOW_EXECUTE_REFUND_SERVICE_TOKEN=CHANGE_ME
# The workers of the cash close, the financial timeouts, the payment expiry and the retention, each with its own token (sub = its name): scripts/dev-token.sh <sub> 90d
WORKER_CASH_CLOSE_SERVICE_TOKEN=CHANGE_ME
WORKER_FINANCIAL_TIMEOUTS_SERVICE_TOKEN=CHANGE_ME
WORKER_PAYMENT_EXPIRY_SERVICE_TOKEN=CHANGE_ME
WORKER_RETENTION_SERVICE_TOKEN=CHANGE_ME
# The commercial api sends the cash income of a payment to cash-reporting with its own token (sub commercial-reservation-api): the security service issues it as a secret of the environment (ADR-004 D5: one token per service and environment, 90 days). Without it the cash payment answers 503.
CASH_REPORTING_SERVICE_TOKEN=CHANGE_ME
# Tenant that receives the demo fixtures of the cash dashboard (cash-reporting-api loads them only when it has this id). Empty = none. Set it after the demo tenant is onboarded (its identifier), never a default.
CASH_FIXTURES_TENANT_ID=
# The commercial api encrypts the sensitive customer fields: current key id and id=base64 of 32 random bytes (openssl rand -base64 32), different in each environment, never versioned
FIELD_ENCRYPTION_CURRENT_KEY_ID=k1
FIELD_ENCRYPTION_KEYS=
# The saga connects as workflow_onboard_tenant_app with the password above (percent-encode reserved characters)
WORKFLOW_ONBOARD_TENANT_DATABASE_URL=postgres://workflow_onboard_tenant_app:${WORKFLOW_ONBOARD_TENANT_APP_PASSWORD}@postgres:5432/${PG_DATABASE}
# The saga that cancels a departure connects as workflow_cancel_departure_app with its own password above
WORKFLOW_CANCEL_DEPARTURE_DATABASE_URL=postgres://workflow_cancel_departure_app:${WORKFLOW_CANCEL_DEPARTURE_APP_PASSWORD}@postgres:5432/${PG_DATABASE}
# The saga of the vehicles connects as workflow_change_departure_vehicles_app with its own password above
WORKFLOW_CHANGE_DEPARTURE_VEHICLES_DATABASE_URL=postgres://workflow_change_departure_vehicles_app:${WORKFLOW_CHANGE_DEPARTURE_VEHICLES_APP_PASSWORD}@postgres:5432/${PG_DATABASE}
# The sagas of the payment and the refund connect as workflow_register_payment_app and workflow_execute_refund_app with their own passwords above
WORKFLOW_REGISTER_PAYMENT_DATABASE_URL=postgres://workflow_register_payment_app:${WORKFLOW_REGISTER_PAYMENT_APP_PASSWORD}@postgres:5432/${PG_DATABASE}
WORKFLOW_EXECUTE_REFUND_DATABASE_URL=postgres://workflow_execute_refund_app:${WORKFLOW_EXECUTE_REFUND_APP_PASSWORD}@postgres:5432/${PG_DATABASE}
# Origin of the front, the only one the gateway grants CORS to
ALLOWED_ORIGIN=http://localhost:4200
# E-mail of the verification links (HU-SEC-003): a real mail server with TLS, never Mailpit
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=no-reply@example.org
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
PUBLIC_BASE_URL=https://app.example.org
# Key of the password recovery codes (HU-SEC-004): at least 32 random bytes, different in each environment and never versioned; the security service refuses to start without it
RECOVERY_CODE_KEY=
