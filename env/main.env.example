# Copy to env/main.env, which is never versioned, and fill every secret. Names and placeholders only.
# A different COMPOSE_PROJECT_NAME per environment gives each one its own container and volume.
COMPOSE_PROJECT_NAME=multi-tour-main
PG_DATABASE=multitour
PG_ADMIN_USER=multitour_admin

# Secrets: no value here, no default anywhere
PG_ADMIN_PASSWORD=
COMMERCIAL_RESERVATION_APP_PASSWORD=
OPERATIONS_COST_APP_PASSWORD=
CASH_REPORTING_APP_PASSWORD=
SECURITY_APP_PASSWORD=
WORKFLOW_ONBOARD_TENANT_APP_PASSWORD=
WORKFLOW_REGISTER_PAYMENT_APP_PASSWORD=
WORKFLOW_EXECUTE_REFUND_APP_PASSWORD=
WORKFLOW_CANCEL_DEPARTURE_APP_PASSWORD=
WORKFLOW_CHANGE_DEPARTURE_VEHICLES_APP_PASSWORD=

# The services that the root composition (platform.yml) includes. Names and placeholders only: a real value goes in env/main.env.
MONGO_INITDB_ROOT_USERNAME=multitour_admin
MONGO_INITDB_ROOT_PASSWORD=
IDENTITY_AUDIT_APP_PASSWORD=
# The identity-audit API connects as identity_audit_app, never as the administrator; use the password above
MONGODB_URI=mongodb://identity_audit_app:CHANGE_ME@mongo:27017/identity_audit?replicaSet=rs0&authSource=identity_audit
# The public key of the security microservice on one line (line breaks written as backslash-n), and the issuer and audience of its tokens: names, not secrets
JWT_PUBLIC_KEY=
JWT_ISSUER=multi-tour-security
JWT_AUDIENCE=multi-tour

# The demo services (security, saga, relay, front, gateway). Names and placeholders only.
# Directory with private.pem and public.pem, absolute: scripts/dev-keys.sh makes them in ./keys (develop only)
JWT_KEYS_DIR=/absolute/path/to/multi-tour-infra-postgres/keys
# The public key as a file (mode 644), read by the saga
JWT_PUBLIC_KEY_PATH=/absolute/path/to/multi-tour-infra-postgres/keys/public.pem
# Where the services reach each other on the platform network
SECURITY_BASE_URL=http://security:8086
IDENTITY_AUDIT_BASE_URL=http://identity-audit-api:8082
# Service tokens, printed by scripts/dev-token.sh (develop) or given by the security service as secrets (qa, main)
SERVICE_TOKEN=CHANGE_ME
WORKFLOW_ONBOARD_TENANT_SERVICE_TOKEN=CHANGE_ME
# The saga connects as workflow_onboard_tenant_app with the password above (percent-encode reserved characters)
WORKFLOW_ONBOARD_TENANT_DATABASE_URL=postgres://workflow_onboard_tenant_app:${WORKFLOW_ONBOARD_TENANT_APP_PASSWORD}@postgres:5432/${PG_DATABASE}
# Origin of the front, the only one the gateway grants CORS to
ALLOWED_ORIGIN=http://localhost:4200
